<Window x:Class="InvestSafra.Views.Entrar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Entrar" Height="450" Width="800" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid  Background="#EFA82E">


            <TextBlock   VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily="Monotype Corsiva" FontSize="25" Margin="0,242,0,0" Height="31" Width="250">Faça Parte do Invest Safra</TextBlock>

            <TextBlock   VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily="Monotype Corsiva" FontSize="25" Margin="0,273,0,0" Height="26" Width="211">O Software que facilita</TextBlock>
            <TextBlock   VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily="Monotype Corsiva" FontSize="25" Margin="0,300,0,0" Height="26" Width="104">a sua vida.</TextBlock>
            <Image Height="177"  VerticalAlignment="Top" Source="/Icons/logoEscuro.png" Margin="10,48,10,0" RenderTransformOrigin="0.514,0.795"/>

        </Grid>
        <Grid Grid.Column="1">
            <Grid.Background>
                <ImageBrush ImageSource="/Imagens/ImgFundoDesfocado.png"/>
            </Grid.Background>

            <Button x:Name="btVoltar" HorizontalAlignment="Right" Height="32"
                    Margin="508,4,0,0"
                    VerticalAlignment="Top" Background="#EFA82E" BorderBrush="#EFA82E"
                    Cursor="Hand"  Width="32">
            </Button>


            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center" >

                <StackPanel.Background>
                    <SolidColorBrush Color="#FF4C4D14" Opacity="0.5"/>
                </StackPanel.Background>
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="400" Height="400">
                    <Label Content="LOGIN" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5" Foreground="Black" FontSize="18"/>
                    <StackPanel VerticalAlignment="Center" Margin="15">
                        <TextBox  Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True"
                             MaxWidth="700" 
                             Margin="0 30 0 0"
                             materialDesign:HintAssist.Hint="Usuário"
                             x:Name="txtUsuario" Padding="16" Grid.Row="1" 
                             TextWrapping="Wrap" 
                             Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="52" Cursor="Arrow" Width="364"/>


                        <PasswordBox
                            Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                            MaxWidth="700" 
                            Margin="0 30 0 0"
                            materialDesign:HintAssist.Hint="Senha"
                            x:Name="psSenha" Padding="16" Grid.Row="1" 
                            Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="52" Cursor="Arrow" Width="364"/>
                        <StackPanel>
                            <Button Name="btLogar" Content="Logar" Cursor="Hand" Margin="0 20 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>



            </StackPanel>


        </Grid>
    </Grid>
</Window>
