<Window x:Class="InvestSafra.Views.Entrar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Entrar" Height="450" Width="800">

    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="/Imagens/ImgFundoDesfocado.png"/>
            </Grid.Background>

            <Grid x:Name="painelHeader" VerticalAlignment="Top" Height="50"
              Background="#EFA82E" MouseDown="painelHeader_MouseDown_1">

                <TextBlock Text="Bem-vindo ao Invest Safra!" FontSize="24"
                       FontFamily="Script MT Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20 0" Cursor="Hand">

                    <Button x:Name="btHome" Content="Home" BorderThickness="10"
                        Background="#EFA82E" BorderBrush="#EFA82E" Foreground="Black"
                        Width="111" Height="41" Click="btHome_Click"/>

                    <Button x:Name="btCadastro" Content="Inscreva-se" Height="40" Width="160"
                        materialDesign:ButtonAssist.CornerRadius="8" Background="#EFA82E"
                        BorderBrush="#EFA82E" Foreground="Black" Click="btCadastrar_Click"
                        Margin="10 0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="SidePainel" Background="#EFA82E" HorizontalAlignment="Left" Width="150">
                <StackPanel>
                    <Grid Height="150" Background="#EFA82E">
                        <Button x:Name="btMenu" HorizontalAlignment="Right" Height="40"
                            VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                            Click="btMenu_Click" Cursor="Hand" Margin="0 0 -8 0" Width="68">
                            <Image Source="/Icons/movedor.png"></Image>
                        </Button>
                    </Grid>
                    <ListView FontFamily="Century Gothic" FontSize="14" Foreground="black"
                          BorderBrush="Transparent" Background="Transparent">
                        <ListViewItem Height="40" x:Name="slhome" Selected="ListViewItem_Selected_1">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Icons/home.png"/>
                                <TextBlock Margin="10 0 0 0" Text="Home" VerticalAlignment="center" FontWeight="bold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Height="40">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Icons/contato.png" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Margin="10 0 0 0" Text="Contatos" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Height="40">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Icons/curiosidade.png" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Margin=" 10 0 0 0" Text="Sobre nós" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
