<Window x:Class="InvestSafra.Views.CadastrarInsumos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="580" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="30" Background="#f7fbfc" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown" Margin="0,0,-52,0">

        <Grid Margin="0,0,0,-28" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="0.043"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="115"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="115"/>
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="3" Margin="0,0,0,10">
                

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1538*"/>
                        <ColumnDefinition Width="17*"/>
                        <ColumnDefinition Width="17*"/>
                    </Grid.ColumnDefinitions>
                    <Image HorizontalAlignment="Left" Height="200" Margin="38,15,0,0" VerticalAlignment="Top" Width="170" Source="/Imagens/LogoCanto.png"/>
                    <Label  Content="Cadastro de Insumos" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="49" Width="292" RenderTransformOrigin="0.336,0.452" Margin="329,44,0,0"/>
                </Grid>

                <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Height="535" >
                    <StackPanel Orientation="Horizontal" Margin="80 10 60 200">
                        <ComboBox
                    materialDesign:HintAssist.Hint="Tipo Insumo" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"   
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbTipoInsumo" Padding="8"  Width="208" Height="58">
                            <ComboBoxItem/>
                            <ComboBoxItem Content="Natural"/>
                            <ComboBoxItem Content="Trabalho"/>
                            <ComboBoxItem Content="Capital"/>
                        </ComboBox>
                        <TextBox 
                
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="50 0 0 0"
                    materialDesign:HintAssist.Hint="Nome"
                    x:Name="txtNome" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />




                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 0 60 0">
                        <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="80 0 50 0"
                    materialDesign:HintAssist.Hint="Descrição"
                    x:Name="txtDescricao1" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />


                        <ComboBox
                    materialDesign:HintAssist.Hint="Medida" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    HorizontalAlignment="Center"   
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbMedida" Padding="8"  Width="208" Grid.Column="1" Grid.Row="1" Height="58">
                            <ComboBoxItem></ComboBoxItem>
                            <ComboBoxItem>Feminino</ComboBoxItem>
                            <ComboBoxItem>Masculino</ComboBoxItem>
                        </ComboBox>


                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0 200 60 0">
                        <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="80 0 50 0"
                    materialDesign:HintAssist.Hint="Quantidade"
                    x:Name="txtQuantidade" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                        <TextBox 
                    
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="0 0 50 0"
                    materialDesign:HintAssist.Hint="Valor"
                    x:Name="txtValor" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />



                    </StackPanel>

                    <Grid Margin="0,465,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="391*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="195*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="334,7,-137,-7" Grid.ColumnSpan="4">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119"  Margin="0,0,20,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.Column="2" Grid.ColumnSpan="2" Click="btSalvar_Click"/>
                                <Button x:Name="btCancelar" FontSize="19" Content="Cancelar" Height="40" Width="119"  Margin="0,0,0,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.ColumnSpan="4" Click="btCancelar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>



                </Grid>
                <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Right">
                    <Button Style="{StaticResource topButton}"  Height="40"  x:Name="btSair" Width="48" Click="btSair_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/Icons/logout.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
