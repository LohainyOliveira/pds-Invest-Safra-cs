<Window x:Class="InvestSafra.Views.CadastrarVenda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
        Title="Venda" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Right">
            <Button Style="{StaticResource topButton}"  Height="40"  x:Name="btSair" Width="48" Click="btSair_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Icons/logout.png"/>
                </Button.Background>
            </Button>
        </StackPanel>

    </Grid>
</Window>
