<Window x:Class="InvestSafra.Views.ClimaFazenda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        
        Height="450" Width="600" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="30" Background="#f7fbfc" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid >

            <Image HorizontalAlignment="Left" Height="115" Margin="38,15,0,0" VerticalAlignment="Top" Width="170" Source="/Imagens/LogoCanto.png"/>
            <Label  Content="Clima Fazenda" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="33" Width="172" RenderTransformOrigin="0.326,0.452" Margin="0,75,0,0"/>





            <StackPanel Orientation="Horizontal" Margin="0,0,16,206">
                <DatePicker 
                       x:Name="dtDia"
                       materialDesign:HintAssist.Hint="Data" 
                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                       Width="206" Height="60" Margin="80 95 0 0"/>

                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="60 93 50 0"
                    materialDesign:HintAssist.Hint="Clima"
                    x:Name="txtClima" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="202" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />




            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,-4,0">
                <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="80 90 50 0"
                    materialDesign:HintAssist.Hint="Temperatura Cº"
                    x:Name="txtTemperatura" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                <TextBox 
                    
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 90 50 0"
                    materialDesign:HintAssist.Hint= "Local"
                    x:Name="txtLocal" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="207" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow" TextChanged="txtLocal_TextChanged"
                  />



            </StackPanel>





            <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Click="btSalvar_Click" Margin="302,377,154,33"/>
            <Button x:Name="btCancelar" FontSize="19" Content="Cancelar" Height="40" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Click="btCancelar_Click" Margin="459,377,10,33"/>


            <Button Style="{StaticResource topButton}"  Height="51"  Margin="539,10,0,389" x:Name="btSair" Width="59" Click="btSair_Click" RenderTransformOrigin="1.108,0.501">
                <Button.Background>
                    <ImageBrush ImageSource="/Icons/logout.png"/>
                </Button.Background>
            </Button>
        </Grid>
    </Border>
</Window>