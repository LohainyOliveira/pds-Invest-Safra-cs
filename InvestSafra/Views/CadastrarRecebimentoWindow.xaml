<Window x:Class="InvestSafra.Views.CadastrarRecebimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CadastrarRecebimentoWindow"
        Height="560" Width="1000" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">


    <Border CornerRadius="30" Background="#f7fbfc" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown" Margin="0,0,-52,0">
        <Grid Margin="0,0,0,-28" RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="0.043"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="115"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="115"/>
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="3" Margin="0,-5,0,10">
                

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1538*"/>
                        <ColumnDefinition Width="17*"/>
                        <ColumnDefinition Width="17*"/>
                    </Grid.ColumnDefinitions>
                    <Image HorizontalAlignment="Left" Height="200" Margin="38,15,0,0" VerticalAlignment="Top" Width="170" Source="/Imagens/LogoCanto.png"/>
                    <Label  Content="Cadastrar Recebimento" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="59" Width="292" RenderTransformOrigin="0.336,0.452" Margin="423,47,0,0"/>
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Right">
                        <Button Style="{StaticResource topButton}"  Height="51"   Margin="0 20 0 0" x:Name="btSair" Width="48" Click="btSair_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/Icons/logout.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>


                <Grid Height="535" Cursor="Arrow" Width="760" >



                    <StackPanel Orientation="Horizontal">
                        <TextBox VerticalAlignment="Center" HorizontalAlignment="Center" Margin="70 0 0 0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Venda"
                    x:Name="txtVenda" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                     />
                        <DatePicker 
                    x:Name="dtPikerDataRecebimento"
                       materialDesign:HintAssist.Hint="Data do Recebimento" 
                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                       Width="260" Height="60" 
                            Margin="70 0 0 0"/>

                    </StackPanel>


                    <Grid Margin="0,465,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="391*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="195*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="334,7,-137,-7" Grid.ColumnSpan="4">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119"  Margin="0,20,20,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.Column="2" Grid.ColumnSpan="2" Click="btSalvar_Click"/>
                                <Button x:Name="btCancelar" FontSize="19" Content="Limpar" Height="40" Width="119"  Margin="0,20,0,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.ColumnSpan="4" Click="btCancelar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>


                </Grid>
            </Grid>
        </Grid>

    </Border>
</Window>
