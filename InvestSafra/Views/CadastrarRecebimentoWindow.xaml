<Window x:Class="InvestSafra.Views.CadastrarRecebimentoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CadastrarRecebimentoWindow"
        Height="500" Width="670" WindowStartupLocation="CenterScreen" WindowStyle="None"
       AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="30" Background="#f7fbfc" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">

        <Grid Margin="0,0,0,-28" RenderTransformOrigin="0.5,0.5">

            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="0.043"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="115"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="115"/>
            </Grid.RowDefinitions>

            <Grid Grid.RowSpan="3" Margin="0,-5,0,10">


                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1538*"/>
                        <ColumnDefinition Width="17*"/>
                        <ColumnDefinition Width="17*"/>
                    </Grid.ColumnDefinitions>
                    <Image HorizontalAlignment="Left" Height="149" Margin="38,15,0,0" VerticalAlignment="Top" Width="158" Source="/Imagens/LogoCanto.png"/>
                    <Label  Content="Cadastrar Recebimento" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="59" Width="279" RenderTransformOrigin="0.336,0.452" Margin="280,47,0,0"/>
                    <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Right">
                        <Button Style="{StaticResource topButton}"  Height="51"   Margin="0 20 0 0" x:Name="btSair" Width="48" Click="btSair_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/Icons/logout.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>


                <Grid Height="535" Cursor="Arrow" Width="760" >






                    <TextBox
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Valor da Venda"
                    x:Name="txtVenda" Padding="16" 
                    TextWrapping="Wrap" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow" Margin="266,290,158,185"
                     />



                    <DatePicker 
                    x:Name="dtPikerDataRecebimento"
                       materialDesign:HintAssist.Hint="Data do Recebimento" 
                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                       Width="219" Height="60" 
                            Margin="24,291,517,0" VerticalAlignment="Top"/>


                    <TextBox VerticalAlignment="Top" HorizontalAlignment="Left" Margin="394,206,0,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Comprador"
                    x:Name="txtComprador" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="56" Cursor="Arrow" TextChanged="txtComprador_TextChanged"
                     />







                    <Grid Margin="0,465,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="391*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="195*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="148,-35,49,35" Grid.ColumnSpan="4">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119"  Margin="0,20,20,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.Column="2" Grid.ColumnSpan="2" Click="btSalvar_Click"/>
                                <Button x:Name="btCancelar" FontSize="19" Content="Limpar" Height="40" Width="119"  Margin="0,20,0,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.ColumnSpan="4" Click="btCancelar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <ComboBox
                    materialDesign:HintAssist.Hint="Caixa" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                       Foreground="black"
                    Margin="22,206,625,0"
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="SemiBold"
                    x:Name="cbCaixa" Padding="8" Height="58"  VerticalAlignment="Top">
                    </ComboBox>

                    <ComboBox
                    materialDesign:HintAssist.Hint="Venda" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                       Foreground="black"
                    Margin="164,207,386,0"
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="SemiBold"
                    x:Name="cbVenda" Padding="8" Height="56"  VerticalAlignment="Top">
                    </ComboBox>

                </Grid>
            </Grid>
        </Grid>

    </Border>
</Window>
