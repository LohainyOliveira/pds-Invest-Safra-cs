<Window x:Class="InvestSafra.Views.LevantamentoDeDadosDaSafra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        Title="LevantamentoDeDadosDaSafra"  Height="450" Width="800" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Storyboard1">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="Basic_Details">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-441"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="Experience">
                <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-435"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Storyboard2">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="Basic_Details">
                <EasingDoubleKeyFrame KeyTime="0" Value="-432"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)" Storyboard.TargetName="Experience">
                <EasingDoubleKeyFrame KeyTime="0" Value="-437"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="UIElement.MouseDown" SourceName="image">
            <BeginStoryboard Storyboard="{StaticResource Storyboard1}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="UIElement.MouseDown" SourceName="image1">
            <BeginStoryboard x:Name="Storyboard2_BeginStoryboard" Storyboard="{StaticResource Storyboard2}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Imagens/ImgDesfocada2.png"/>
        </Grid.Background>
        <StackPanel Margin="190 20 20 20">

            <StackPanel.Background>
                <SolidColorBrush Color="#FF849246" />
            </StackPanel.Background>
        </StackPanel>
       
            <Button Style="{StaticResource topButton}"  Height="40" Margin="730 -360 0 0" x:Name="btSair" Width="48" Click="btSair_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/Icons/logout.png"/>
                </Button.Background>
            </Button>
       


        <Rectangle Fill="#EFA82E" HorizontalAlignment="Left" Height="450" VerticalAlignment="Top" Width="178.795"/>
        <Grid x:Name="Basic_Details" HorizontalAlignment="Left" Height="412" Margin="179,0,0,0" VerticalAlignment="Top" Width="611" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>



            <TextBlock HorizontalAlignment="Left" Height="31" Margin="28,46,0,0" TextWrapping="Wrap" Text="Levantamento de Dados Safra" VerticalAlignment="Top" Width="383" FontSize="20" FontFamily="Open Sans" Foreground="#EFA82E"/>

            <ListBox Width="150" HorizontalAlignment="Left" x:Name="listSafra1" Margin="30 100 30 30">
                <ListBoxItem Height="130" Width="150" HorizontalAlignment="Left">
                    <Image Source="/Icons/arroz.png"/>
                </ListBoxItem>
                <ListBoxItem Height="130" Width="150" HorizontalAlignment="Left">
                    <Image Source="/Icons/feijão.png"/>
                </ListBoxItem>

            </ListBox>

            <ListBox Width="150" HorizontalAlignment="Center" x:Name="listSafra2" Margin="30 100 30 30">
                <ListBoxItem Height="130" Width="150" HorizontalAlignment="Left">
                    <Image Source="/Icons/milho.png"/>
                </ListBoxItem>
                <ListBoxItem Height="130" Width="150" HorizontalAlignment="Left">
                    <Image Source="/Icons/soja.png"/>
                </ListBoxItem>

            </ListBox>

            <ListBox Width="150" HorizontalAlignment="Right" x:Name="listSafra3" Margin="30 100 30 30">
                <ListBoxItem Height="150" Width="150" HorizontalAlignment="Left">
                    <Image Source="/Icons/trigo.png"/>
                </ListBoxItem>
            </ListBox>

        </Grid>
        <Grid x:Name="Experience" HorizontalAlignment="Left" Height="450" Margin="178.795,436,0,-436" VerticalAlignment="Top" Width="621.205" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Grid.RenderTransform>

            <DatePicker 
                       x:Name="dtPickerDataInicio"
                       materialDesign:HintAssist.Hint="Data do Inicio da Plantação" 
                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                       Width="260" Height="60" Margin="0,75,310,0" VerticalAlignment="Top" />
            <DatePicker 
                       x:Name="dtPickerDataFim"
                       materialDesign:HintAssist.Hint="Data Fim Plantação" 
                       Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                       Width="260" Height="60" Margin="305,75,10,0" VerticalAlignment="Top" />
            <TextBox HorizontalAlignment="Left" 
                             Height="195"
                             materialDesign:HintAssist.Hint="Descrição e Observações a serem Declaradas....." 
                      Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            
                             VerticalAlignment="Top" 
                             Width="565" Margin="20,179,0,0"/>

            <StackPanel HorizontalAlignment="Right"  Orientation="Horizontal" >
                <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119"  Margin="0 350 20 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.Column="2" Grid.ColumnSpan="2"/>
                <Button x:Name="btCancelar" FontSize="19" Content="Cancelar" Height="40" Width="119"  Margin="0 350 40 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Grid.ColumnSpan="4"/>
            </StackPanel>
        </Grid>
        <Image x:Name="image1" HorizontalAlignment="Left" Height="56.25" Margin="62.277,36.161,0,0" VerticalAlignment="Top" Width="56.25" Source="/Icons/setaCima.png"/>
        <Image x:Name="image" HorizontalAlignment="Left" Height="56.25" Margin="62.277,355.581,0,0" VerticalAlignment="Top" Width="56.25" Source="/Icons/setaBaixa.png"/>

    </Grid>



</Window>
