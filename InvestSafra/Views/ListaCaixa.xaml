<Window x:Class="InvestSafra.Views.ListaCaixa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Height="720" Width="1080" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="White" CornerRadius="30" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="89*"/>
                <ColumnDefinition Width="21*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            </Grid>

            <Border Background="#EFA82E" CornerRadius="0 50 0 02" Margin="0,117,0,0">
                <DockPanel>
                    <Border Width="80" Height="80" Padding="3" Background="white" CornerRadius="100"
                            DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0 -30 0 0">
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/Imagens/usu.png" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Border>

                    <TextBlock Text="Invest Safra" Foreground="Black" FontSize="22" FontWeight="SemiBold"
                               DockPanel.Dock="Top" TextAlignment="Center" Margin="5 25 0 10"/>
                    <TextBlock Text="Lista de Caixa" Foreground="#FF04020A" FontSize="14" FontWeight="SemiBold"
                               DockPanel.Dock="Top" TextAlignment="Center"/>

                    <Separator Margin="25" DockPanel.Dock="Top" Height="0.8" Background="Black"/>

                    <StackPanel DockPanel.Dock="Top">
                        <Button Height="56" Background="#EFA82E" BorderBrush="#EFA82E">
                            <DockPanel>
                                <Icon:PackIconMaterial Kind="HomeVariant" Style="{StaticResource ResourceKey=menuButtonIcon}" RenderTransformOrigin="0.133,0.48" Foreground="#FF1D0A0A"/>
                                <TextBlock Text="Menu" Width="49" Foreground="Black"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top"/>

                    <DockPanel/>

                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30,20,20,20" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="94*"/>
                    <RowDefinition Height="133*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Left" Margin="782,0,0,0">
                    <Button Style="{StaticResource topButton}"  Height="40"  x:Name="btSair" Width="48" Click="btSair_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/Icons/logout.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <TextBlock Text="Caixa" Grid.Row="1" FontSize="32" FontWeight="SemiBold" Margin="0,20,0,8"
                           HorizontalAlignment="Left" Foreground="black" Grid.RowSpan="2"/>

                <Button Style="{StaticResource addButton}" Background="#FF040306" Margin="0,24,0,4" Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <Icon:PackIconMaterial Kind="Plus" VerticalAlignment="Center" Width="11" Height="11" Margin="0 20 0 0"/>
                        <TextBlock Text="Add New Caixa" Height="19"/>
                    </StackPanel>
                </Button>



                <Separator Height="1" Grid.Row="3" Background="white" Margin="0,3,0,14"/>

                <!--<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 10 0 0">
                    <Button Content="Club Staff" Style="{StaticResource tabButton}"/>
                    <Button Content="Players" Style="{StaticResource tabButton}"/>
                    <Button Content="Archived" Style="{StaticResource tabButton}"/>
                </StackPanel>-->


                <TextBlock Text="Atualize ou Delete o Seu Caixa Aqui"  Grid.Row="2" FontSize="18"  FontWeight="SemiBold"
                           Foreground="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="504,2,0,0" Width="330" Grid.RowSpan="3"/>



                <Grid Width="200" HorizontalAlignment="Left" Grid.Row="4" Margin="630,0,0,0">

                    <Icon:PackIconMaterial Kind="Magnify" Height="15" VerticalAlignment="Center" Margin="0 0 15 0"
                                           Foreground="black" HorizontalAlignment="Right"/>
                </Grid>

                <DataGrid ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" RowStyle="{DynamicResource DataGridRowStyle1}" Grid.Row="4" x:Name="dataGridCaixa" IsReadOnly="true" AlternatingRowBackground="#FFE5E5E5" AlternationCount="2" AutoGenerateColumns="False" Background="#FFFAFAFA" Margin="0,37,0,60" Grid.RowSpan="4">
                    <DataGrid.Columns>

                        <!-- Começo CheckBox -->
                        <DataGridCheckBoxColumn CanUserResize="False" Width="auto">
                            <DataGridCheckBoxColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox/>
                                </DataTemplate>
                            </DataGridCheckBoxColumn.HeaderTemplate>
                        </DataGridCheckBoxColumn>
                        <!-- Fim CheckBox -->
                        <!-- Começo -->
                        <DataGridTextColumn Header="Numero" Binding="{Binding Numero }"/>
                        <DataGridTextColumn Header="Saldo Inicial" Binding="{Binding SaldoInicial }"/>
                        <DataGridTextColumn Header="Saldo Final" Binding="{Binding SaldoFinal}"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding Data_Hora}"/>

                        <DataGridTemplateColumn Header="Operation" IsReadOnly="True" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Click="btAtualizar_Click" Style="{StaticResource GridEditButton}">
                                            <Icon:PackIconMaterial Kind="PencilOutline" Style="{StaticResource GridButtonIcon}"/>
                                        </Button>
                                        <Button Click="btRemover_Click" Margin="20 0 0 0" Style="{StaticResource GridRemoveButton}">
                                            <Icon:PackIconMaterial Kind="DeleteOutline" Style="{StaticResource GridButtonIcon}"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Border>

</Window>

