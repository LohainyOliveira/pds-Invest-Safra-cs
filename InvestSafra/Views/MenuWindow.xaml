<Window x:Class="InvestSafra.Views.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Height="653" Width="890">
    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <hc:ThemeResources/>
                    <hc:Theme/>
                </ResourceDictionary.MergedDictionaries>

            </ResourceDictionary>
        </Grid.Resources>


        <Grid.Background>
            <ImageBrush ImageSource="/Imagens/ImgFundoDesfocado.png"/>
        </Grid.Background>



        <Grid x:Name="painelHeader" VerticalAlignment="Top" Height="50"
              Background="#EFA82E" MouseDown="painelHeader_MouseDown_1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="747*"/>
                <ColumnDefinition Width="0*"/>
                <ColumnDefinition Width="53*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Sejam Bem Vindos !!!" FontSize="24"
                       FontFamily="Script MT Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Margin="294,0,0,0"/>
            

        </Grid>
        <Grid x:Name="SidePainel" Background="#EFA82E" HorizontalAlignment="Left" Width="160">
            <StackPanel>
                <Grid Height="150" Background="#EFA82E">
                    <Button x:Name="btMenu" HorizontalAlignment="Right" Height="50"
                            VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                            Click="btMenu_Click" Cursor="Hand" Margin="0 0 0 0" >
                        <Image Source="/Icons/movedor.png"/>
                    </Button>
                </Grid>

                <!-- Imagm Cliente
                    <DockPanel>
                        <Border Width="80" Height="80" Padding="3" Background="Black" CornerRadius="100"
                            DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0 -65 0 0">
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                    </DockPanel>
                    -->

            </StackPanel>

            <hc:SideMenu Margin="0 150 0 0" FontSize="14" Foreground="black"
                          BorderBrush="Transparent" Background="Transparent" Height="600"
>
                <hc:Interaction.Triggers>
                    <hc:EventTrigger EventName="SelectionChanged">
                        <hc:EventToCommand Command="{Binding SwitchItemCmd}" PassEventArgsToCommand="True" />
                    </hc:EventTrigger>
                </hc:Interaction.Triggers>

                <hc:SideMenuItem Background="Transparent" Foreground="black" Selected="SideMenuItemHome_Selected"
                                 Header="Home" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/home.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>


                <hc:SideMenuItem Background="Transparent" Foreground="Black" Header="Listagem" 
                                 FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/lista.png" />

                    </hc:SideMenuItem.Icon>




                    <!-- Começo das  Listas -->

                    <hc:SideMenuItem Selected="SideMenuItemListaArea_Selected" Header="Lista Área " Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Caixa"  Selected="SideMenuItemListaCaixa_Selected" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Empresa" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Clima" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Compra" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Estoque" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Fazenda" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Fornecedor" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Funcionário" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Insumos" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Safra" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Background="Transparent" Foreground="Black" Header="Lista Maquinas" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Background="Transparent" Foreground="Black" Header="Lista Produto" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Background="Transparent" Foreground="Black" Header="Lista Sementes" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <hc:SideMenuItem Header="Lista Venda" Background="Transparent" Foreground="Black" Command="{Binding SelectCmd}" CommandParameter="{Binding Header,RelativeSource={RelativeSource Self}}">
                        <hc:SideMenuItem.Icon>
                            <Image Height="30"  Source="/Icons/marcador.png"/>
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>
                </hc:SideMenuItem>

                <!-- Fim das  Listas -->


                <hc:SideMenuItem Background="Transparent" Header="Áreas" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/area.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Caixa" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/caixa.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Clima" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/clima2.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Compra" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/compra.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Empresas" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/Empresa.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Estoque" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/estoquePreto.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Fazendas" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/fazenda.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Fornecedores" Foreground="black" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/fornecedor.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Funcionários" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/funcionario.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Maquinas" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/maquinas.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Safra" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/safra.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Semente" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/sementePreto.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Venda" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image  Height="30"  Source="/Icons/venda.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>


                <hc:SideMenuItem Background="Transparent" Header="Produtos" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image  Height="30" Source="/Icons/produtos.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>


                <hc:SideMenuItem Background="Transparent" Header="Conta" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/conta.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>


                <hc:SideMenuItem Background="Transparent" Header="Contatos" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30"  Source="/Icons/contato.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem>

                <hc:SideMenuItem Background="Transparent" Header="Curiosidades" FontFamily="Arial" FontWeight="Bold">
                    <hc:SideMenuItem.Icon>
                        <Image Height="30" Source="/Icons/curiosidade.png"/>
                    </hc:SideMenuItem.Icon>
                </hc:SideMenuItem> ;


            </hc:SideMenu>
        </Grid>
    </Grid>
</Window>
