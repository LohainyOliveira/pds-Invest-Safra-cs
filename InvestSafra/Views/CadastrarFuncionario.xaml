<Window x:Class="InvestSafra.Views.CadastrarFuncionario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Height="860" Width="1300" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="30" Background="#f7fbfc" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown" Margin="0,0,-52,0">
        <Grid Margin="0,0,-23,-151">
            <Grid.RowDefinitions>
                <RowDefinition Height="185"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>


            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1538*"/>
                    <ColumnDefinition Width="17*"/>
                    <ColumnDefinition Width="17*"/>
                </Grid.ColumnDefinitions>
                <Image HorizontalAlignment="Left" Height="200" Margin="38,15,0,0" VerticalAlignment="Top" Width="170" Source="/Imagens/LogoCanto.png"/>
                <Label  Content="Cadastro Funcionário" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="50" Width="292" RenderTransformOrigin="0.326,0.452" Margin="0,75,0,0"/>
            </Grid>

            <Grid VerticalAlignment="Top" Grid.Row="1" HorizontalAlignment="Center" >
                <StackPanel Orientation="Horizontal" Margin="0 0 60 200">
                    <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="70 -130 50 0"
                    materialDesign:HintAssist.Hint="Nome Completo"
                    x:Name="txtNomeCompleto" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                    <TextBox 
                
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 -130 50 0"
                    materialDesign:HintAssist.Hint="CPF"
                    x:Name="txtCPF" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                    <ComboBox
                    materialDesign:HintAssist.Hint="Sexo" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    HorizontalAlignment="Center"   
                    Margin="10 -130 50 0"
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbSexo" Padding="8"  Width="208" Grid.Column="1" Grid.Row="1" Height="58">
                        <ComboBoxItem></ComboBoxItem>
                        <ComboBoxItem>Feminino</ComboBoxItem>
                        <ComboBoxItem>Masculino</ComboBoxItem>
                    </ComboBox>

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 0 60 0">
                    <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="70 -130 50 0"
                    materialDesign:HintAssist.Hint="Email"
                    x:Name="txtEmail" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                    <TextBox 
                    
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 -130 50 0"
                    materialDesign:HintAssist.Hint="RG"
                    x:Name="txtRg" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="208" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                    <TextBox 
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="12 -130 50 0"
                    materialDesign:HintAssist.Hint="Telefone"
                    x:Name="txtTelefone" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="206" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 210 60 0">
                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="70 -130 50 0"
                    materialDesign:HintAssist.Hint="Função"
                    x:Name="txtfuncao" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 -130 50 0"
                    materialDesign:HintAssist.Hint="Salario"
                    x:Name="txtsalario" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />



                    <TextBox 
                   Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 -130 50 0"
                    materialDesign:HintAssist.Hint="CEP"
                    x:Name="txtCEP" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="210" Background="#f7fbfc"  FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />


                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,350,60,-76">
                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="70 -130 50 0"
                    materialDesign:HintAssist.Hint="Cidade"
                    x:Name="txtCidade" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />



                    <ComboBox
                    materialDesign:HintAssist.Hint="Estado" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"   
                    Background="#f7fbfc" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbEstado" Padding="8"  Margin="10 -130 0 0" Width="209" Grid.Column="1" Grid.Row="1" Height="58">

                        <ComboBoxItem></ComboBoxItem>
                        <ComboBoxItem>AC</ComboBoxItem>
                        <ComboBoxItem>AM</ComboBoxItem>
                        <ComboBoxItem>RO</ComboBoxItem>
                        <ComboBoxItem>RR</ComboBoxItem>
                        <ComboBoxItem>PA</ComboBoxItem>
                        <ComboBoxItem>AP</ComboBoxItem>
                        <ComboBoxItem>MT</ComboBoxItem>
                        <ComboBoxItem>MS</ComboBoxItem>
                        <ComboBoxItem>MA</ComboBoxItem>
                        <ComboBoxItem>TO</ComboBoxItem>
                        <ComboBoxItem>GO</ComboBoxItem>
                        <ComboBoxItem>PI</ComboBoxItem>
                        <ComboBoxItem>CE</ComboBoxItem>
                        <ComboBoxItem>RN</ComboBoxItem>
                        <ComboBoxItem>PB</ComboBoxItem>
                        <ComboBoxItem>PE</ComboBoxItem>
                        <ComboBoxItem>AL</ComboBoxItem>
                        <ComboBoxItem>SE</ComboBoxItem>
                        <ComboBoxItem>BA</ComboBoxItem>
                        <ComboBoxItem>MG</ComboBoxItem>
                        <ComboBoxItem>ES</ComboBoxItem>
                        <ComboBoxItem>RJ</ComboBoxItem>
                        <ComboBoxItem>SP</ComboBoxItem>
                        <ComboBoxItem>PR</ComboBoxItem>
                        <ComboBoxItem>SC</ComboBoxItem>
                        <ComboBoxItem>RS</ComboBoxItem>
                        <ComboBoxItem>TO</ComboBoxItem>
                    </ComboBox>





                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0 210 0 0">
                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="607 80 50 0"
                    materialDesign:HintAssist.Hint="Rua"
                    x:Name="txtRua" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,350,60,-76">
                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="70 90 50 0"
                    materialDesign:HintAssist.Hint="Bairro"
                    x:Name="txtBairro" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                    <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 90 0 0"
                    materialDesign:HintAssist.Hint="Complemento"
                    x:Name="txtComplemento" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="209" Background="#f7fbfc" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />


                </StackPanel>



            </Grid>

            <Grid Grid.Row="1" Margin="0,490,10,63">
                <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119" HorizontalAlignment="Right" Margin="10 50 50 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Click="btSalvar_Click"/>
                <Button x:Name="btLimpar" FontSize="19" Content="Limpar" Width="119" HorizontalAlignment="Right" Margin="0,113,200,0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand" Click="btLimpar_Click" Height="40" VerticalAlignment="Top"/>
            </Grid>
            <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Right">
                <Button Style="{StaticResource topButton}"  Height="51"  Margin="0 20 40 0" x:Name="btSair" Width="48" Click="btSair_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Icons/logout.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</Window>
