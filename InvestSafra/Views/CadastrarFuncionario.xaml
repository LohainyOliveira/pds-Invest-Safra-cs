<Window x:Class="InvestSafra.Views.CadastrarFuncionario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="CadastrarFuncionario" Height="708" Width="1400">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/Imagens/imgDesfocada2.png"/>
        </Grid.Background>

        <Grid Grid.Row="0">
            <Image HorizontalAlignment="Left" Height="185" Margin="38,15,0,0" VerticalAlignment="Top" Width="198" Source="/Imagens/LogoCanto.png"/>
            <Label  Content="Cadastro de Funcionário" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Arial" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="75" Width="292" RenderTransformOrigin="0.326,0.452"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0 0 0 250" >
                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="Nome Completo"
                    x:Name="NomeCompleto" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="CPF"
                    x:Name="CPF" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                <ComboBox
                    materialDesign:HintAssist.Hint="Sexo" 
                    HorizontalAlignment="Center"   
                    Background="#0F040302" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbSexo" Padding="8"  Width="300" Grid.Column="1" Grid.Row="1" Height="58">
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem>Feminino</ComboBoxItem>
                    <ComboBoxItem>Masculino</ComboBoxItem>
                </ComboBox>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="Email"
                    x:Name="Email" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="Data Nascimento"
                    x:Name="txtDataNascimento" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="RG"
                    x:Name="txtRg" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="0,230,32,0">

                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="Setor"
                    x:Name="txtSetor" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />
                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="10 0 80 0"
                    materialDesign:HintAssist.Hint="Função"
                    x:Name="txtFuncao" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

                <TextBox 
                    Style="{StaticResource MaterialDesignFilledTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Salário"
                    x:Name="txtSalario" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="300" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

            </StackPanel>



        </Grid>

        <Grid Grid.Row="1" Margin="0,517,10,10" Grid.RowSpan="2">
            <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119" HorizontalAlignment="Right" Margin="10 0 50 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand"/>
            <Button x:Name="btLimpar" FontSize="19" Content="Limpar" Height="40" Width="119" HorizontalAlignment="Right" Margin="10 0 200 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
