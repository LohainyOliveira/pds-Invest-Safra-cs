<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="InvestSafra.Views.CadastroUsuario"
        mc:Ignorable="d"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
         Height="700" Width="500" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="0" MouseDown="Border_MouseDown" MouseLeftButtonDown="Border_MouseLeftButtonDown" >
        <Border.Background>
            <ImageBrush ImageSource="/Imagens/ImgFundoDesfocado.png"/>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="95"/>
                <RowDefinition Height="463"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="0*"/>

            </Grid.ColumnDefinitions>

            <Border Background="#EFA82E" Height="94" VerticalAlignment="Center" CornerRadius="0 0 0 0" >
                <Image HorizontalAlignment="Left" Height="82" Margin="22,0,0,0" VerticalAlignment="Center" Width="109" Source="/Icons/logoEscuro.png"/>
            </Border>
            <TextBlock Margin="170,34,163,34" Text="Cadastro de Usuário" FontFamily="Monotype Corsiva" FontWeight="Bold" FontSize="22" />


            <Grid MinWidth="4" Grid.RowSpan="3" Margin="0,0,0,10">

                <StackPanel VerticalAlignment="Top"
                            HorizontalAlignment="Center" Height="488" Width="408" Margin="0,136,0,0" Opacity="0.9" >
                    <StackPanel.Background>
                        <SolidColorBrush Color="#FF929245" Opacity="0.5"/>
                    </StackPanel.Background>


                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Width="400" Height="400">
                        <StackPanel VerticalAlignment="Center" Margin="15">

                            <ComboBox
                                materialDesign:HintAssist.Hint="Cliente...." 
                                Style="{StaticResource MaterialDesignComboBox}"   
                                Background="#0F040302" FontFamily="Arial" FontWeight="Bold"
                                x:Name="cbCliente" Padding="8"  Margin="0 0 0 0" Width="363" Grid.Column="1" Grid.Row="1" Height="52">
                            </ComboBox>
                            <TextBox  Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                AcceptsReturn="True"
                                MaxWidth="700" 
                                Margin="0 20 0 0"
                                materialDesign:HintAssist.Hint="Usuário"
                                x:Name="txtUsuario" Padding="16" Grid.Row="1" 
                                TextWrapping="Wrap" 
                                Background="#0F040302" FontFamily="Arial" FontWeight="Bold" Height="52" Cursor="Arrow" Width="364"/>

                            <PasswordBox
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                MaxWidth="700" 
                                Margin="0 30 0 0"
                                materialDesign:HintAssist.Hint="Senha"
                                x:Name="psSenha" Padding="16" Grid.Row="1" 
                                Background="#0F040302" FontFamily="Arial" FontWeight="Bold" Height="52" Cursor="Arrow" Width="364"/>
                            <PasswordBox
                                Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                MaxWidth="700" 
                                Margin="0 30 0 0"
                                materialDesign:HintAssist.Hint="Digite a senha novamente"
                                x:Name="psSenha2" Padding="16" Grid.Row="1" 
                                Background="#0F040302" FontFamily="Arial" FontWeight="Bold" Height="52" Cursor="Arrow" Width="364"/>

                            <StackPanel>
                                <Button x:Name="btSalvar" BorderBrush="#EFA82E" Background="#EFA82E" Content="Cadastrar" Cursor="Hand" Margin="0 20 0 0" Foreground="Black" />
                                <Button x:Name="btCancelar" BorderBrush="#EFA82E" Background="#EFA82E" Content="Cancelar" Cursor="Hand" Margin="0 10 0 0" Foreground="Black" Click="btCancelar_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

    </Border>
</Window>
