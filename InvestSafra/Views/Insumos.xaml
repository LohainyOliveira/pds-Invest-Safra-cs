<Window x:Class="InvestSafra.Views.Insumos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra.Views"
        mc:Ignorable="d"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Title="Insumos" Height="450" Width="800">
    <Grid Margin="0,0,0,-160">
        <Grid.RowDefinitions>
            <RowDefinition Height="115"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <ImageBrush ImageSource="/Imagens/ImgDesfocada2.png"/>
        </Grid.Background>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1538*"/>
                <ColumnDefinition Width="17*"/>
                <ColumnDefinition Width="17*"/>
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Left" Height="100" Margin="38,15,0,0" VerticalAlignment="Top" Width="136" Source="/Imagens/LogoCanto.png"/>
            <Label  Content="Cadastro de Insumos" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Malik" FontSize="24" Foreground="#EFA82E" FontWeight="Bold" Height="50" Width="292" RenderTransformOrigin="0.326,0.452"/>
        </Grid>

        <Grid VerticalAlignment="Top" Grid.Row="1" HorizontalAlignment="Center" >
            <StackPanel Orientation="Horizontal" Margin="0 0 0 0">
                <ComboBox
                    materialDesign:HintAssist.Hint="Tipo de Insumo" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                    HorizontalAlignment="Center"   
                    Background="#0F040302" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbTipoInsumo" Padding="8"  Width="208" Grid.Column="1" Grid.Row="1" Height="58">
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem>Fertilizantes</ComboBoxItem>
                    <ComboBoxItem>Defensivos</ComboBoxItem>
                </ComboBox>

                <TextBox 
                
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="60 0 0 0"
                    materialDesign:HintAssist.Hint="Marca"
                    x:Name="txtMarca" Padding="16"  
                    TextWrapping="Wrap" 
                    Width="208" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60"
                  />

                <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Descrição"
                    x:Name="txtDescricao" Padding="16" Grid.Row="1" Margin="10 0 0 0"
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />

            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,-22,-175">
                <TextBox 
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    Margin="0 0 50 0"
                    materialDesign:HintAssist.Hint="Quantidade de insumo"
                    x:Name="txtQTDInsumo" Padding="16" Grid.Row="1" 
                    TextWrapping="Wrap" VerticalAlignment="Center" 
                    Width="208" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Cursor="Arrow"
                  />


                <ComboBox
                    materialDesign:HintAssist.Hint="Medida" 
                    Style="{StaticResource MaterialDesignOutlinedComboBox}"   
                    Background="#0F040302" FontFamily="Arial" FontWeight="Bold"
                    x:Name="cbMedida" Padding="8"  Width="100" Grid.Column="1" Grid.Row="1" Height="58" Margin="-20 0 0 0">
                    <ComboBoxItem></ComboBoxItem>
                    <ComboBoxItem>g</ComboBoxItem>
                    <ComboBoxItem>kg</ComboBoxItem>
                    <ComboBoxItem>dg</ComboBoxItem>
                    <ComboBoxItem>t</ComboBoxItem>
                    <ComboBoxItem>outros</ComboBoxItem>
                </ComboBox>
                <TextBox 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    AcceptsReturn="True"
                    MaxWidth="400"
                    materialDesign:HintAssist.Hint="Valor dos Insumos"
                    x:Name="txtValorinsumos" Padding="16" 
                    TextWrapping="Wrap" 
                    Width="288" Background="#0F040302" FontFamily="Arial" FontSize="14" FontWeight="Bold" Height="60" Margin="20 0 0 0" RenderTransformOrigin="0.5,0.5"
                  >
                    <TextBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0.031"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </TextBox.RenderTransform>
                </TextBox>
            </StackPanel>



        </Grid>

        <Grid Grid.Row="1" Margin="0,517,10,10" Grid.RowSpan="2">
            <Button x:Name="btSalvar" FontSize="19" Content="Salvar" Height="40" Width="119" HorizontalAlignment="Right" Margin="10 0 50 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand"/>
            <Button x:Name="btLimpar" FontSize="19" Content="Limpar" Height="40" Width="119" HorizontalAlignment="Right" Margin="10 0 200 0" BorderThickness="17" Foreground="Black" BorderBrush="#EFA82E" Background="#EFA82E" Cursor="Hand"/>
        </Grid>
    </Grid>

</Window>
