<Window x:Class="InvestSafra.TelaPrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvestSafra"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="TelaPrincipalWindow" Height="653" Width="890">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Imagens/ImgFundoDesfocado.png"/>
        </Grid.Background>

        <Grid x:Name="painelHeader" VerticalAlignment="Top" Height="50"
              Background="#EFA82E" MouseDown="painelHeader_MouseDown_1">

            <TextBlock Text="Bem-vindo ao Invest Safra!" FontSize="24"
                       FontFamily="Script MT Bold" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="20 0" Cursor="Hand">

                <Button x:Name="btHome" Content="Entrar" BorderThickness="10"
                        Background="#EFA82E" BorderBrush="#EFA82E" Foreground="Black"
                        Width="111" Height="41" Click="btHome_Click" Cursor="Hand"/>

                <Button x:Name="btCadastro" Content="Inscreva-se" Height="40" Width="160"
                        materialDesign:ButtonAssist.CornerRadius="8" Background="#EFA82E"
                        BorderBrush="#EFA82E" Foreground="Black" Click="btCadastrar_Click"
                        Margin="10 0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="SidePainel" Background="#EFA82E" HorizontalAlignment="Left" Width="150">
            <StackPanel>
                <Grid Height="150" Background="#EFA82E">
                    <Button x:Name="btMenu" HorizontalAlignment="Right" Height="50"
                            VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                            Click="btMenu_Click" Cursor="Hand" Margin="0 0 0 0" >
                        <Image Source="/Icons/movedor.png"/>
                    </Button>

                    <Image Source="/Icons/logoEscuro.png" Margin="0,44,14,16" />
                </Grid>
                <ListView FontFamily="Century Gothic" FontSize="14" Foreground="black"
                          BorderBrush="Transparent" Background="Transparent">

                    <ListViewItem Height="40" x:Name="slhome" Selected="ListViewItem_Selected_1">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/home.png"/>
                            <TextBlock Margin="10 0 0 0" Text="Home" VerticalAlignment="center" FontWeight="bold" FontFamily="Arial"/>
                        </StackPanel>
                    </ListViewItem>


                    <ListViewItem Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/conta.png" Height="26" VerticalAlignment="Center" Width="21"/>
                            <TextBlock Margin="10 0 0 0" Text="Conta" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Arial"/>
                        </StackPanel>
                    </ListViewItem>

                    <ListViewItem Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/contato.png" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Margin="10 0 0 0" Text="Contatos" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Arial"/>
                        </StackPanel>
                    </ListViewItem>

                    <ListViewItem Height="40">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Icons/curiosidade.png" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Margin=" 10 0 0 0" Text="Sobre nós" VerticalAlignment="Center" FontWeight="Bold" FontFamily="Arial"/>
                        </StackPanel>
                    </ListViewItem>

                </ListView>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Imagens/logo_pgnPrincipal.png" Height="400"/>
        </StackPanel>



    </Grid>
</Window>
